      "captions": [],
      "narration": [
        {
          "start": 0.15,
          "end": 2.85,
          "text": "Relembra o trailer que parou o mundo.",
          "emphasis": [
            "trailer",
            "mundo."
          ]
        },
        {
          "start": 3.38,
          "end": 8.28,
          "text": "Ele quebrou a internet: noventa milhões de views em vinte e quatro horas.",
          "emphasis": [
            "internet:",
            "noventa",
            "milhões"
          ]
        },
        {
          "start": 8.51,
          "end": 11.51,
          "text": "Recorde no Guinness, passando até o MrBeast.",
          "emphasis": [
            "Guinness,",
            "MrBeast."
          ]
        },
        {
          "start": 11.88,
          "end": 16.78,
          "text": "Tudo começa com a Lucia, a nova protagonista, presa, dizendo que foi só azar.",
          "emphasis": [
            "Lucia,",
            "azar."
          ]
        },
        {
          "start": 17.05,
          "end": 22.55,
          "text": "Bem-vindo a Leonida, a versão do GTA pra Flórida, com a Vice City de volta.",
          "emphasis": [
            "Leonida,",
            "Vice",
            "City"
          ]
        },
        {
          "start": 23.22,
          "end": 27.92,
          "text": "Vídeos de rede social? Pura zoeira com o meme do Florida Man.",
          "emphasis": [
            "Florida",
            "Man."
          ]
        },
        {
          "start": 28.12,
          "end": 32.32,
          "text": "Jacaré na piscina, festa no posto em plena tempestade... caos total.",
          "emphasis": [
            "Jacaré",
            "caos"
          ]
        },
        {
          "start": 32.62,
          "end": 36.52,
          "text": "Até o Weazel News voltou, cobrindo as doideiras da cidade.",
          "emphasis": [
            "Weazel",
            "News"
          ]
        },
        {
          "start": 36.72,
          "end": 40.32,
          "text": "Lucia e Jason assaltando juntos, estilo Bonnie e Clyde.",
          "emphasis": [
            "Bonnie",
            "Clyde."
          ]
        },
        {
          "start": 40.92,
          "end": 44.72,
          "text": "E a trilha? Love Is a Long Road, do Tom Petty.",
          "emphasis": [
            "Love",
            "Petty."
          ]
        },
        {
          "start": 46.98,
          "end": 49.88,
          "text": "Dezenove de novembro, no PS5 e Xbox Series.",
          "emphasis": [
            "Dezenove",
            "novembro,"
          ]
        },
        {
          "start": 50.36,
          "end": 52.36,
          "text": "Segue pra não perder nada!",
          "emphasis": []
        }
      ],
